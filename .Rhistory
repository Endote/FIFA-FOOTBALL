sdm_df <- sdm_df %>% filter(itl_code %in% ord) %>%
mutate(itl_code = factor(itl_code, levels = ord)) %>%
arrange(itl_code, year)
# Model A: baseline SDM (naive)
m_sdm_naive <- spml(
g_real_lead ~ d_js_dist + hhi + entropy + switch,
data = sdm_df,
index = c("itl_code","year"),
listw = lw_knn,
model = "within",
effect = "twoways",
lag = TRUE,
Durbin = TRUE,
spatial.error = "none",
zero.policy = TRUE
)
# Model B: SDM with ILR composition (this implicitly includes W·z because Durbin=TRUE)
ilr_rhs <- paste0("z", 1:17, collapse = " + ")
f_sdm_ilr <- as.formula(paste0("g_real_lead ~ ", ilr_rhs, " + switch"))
m_sdm_ilr <- spml(
f_sdm_ilr,
data = sdm_df,
index = c("itl_code","year"),
listw = lw_knn,
model = "within",
effect = "twoways",
lag = TRUE,
Durbin = TRUE,
spatial.error = "none",
zero.policy = TRUE
)
# Model C: compact directed channel (projection) + switch
m_sdm_proj <- spml(
g_real_lead ~ proj_nat + switch,
data = sdm_df,
index = c("itl_code","year"),
listw = lw_knn,
model = "within",
effect = "twoways",
lag = TRUE,
Durbin = TRUE,
spatial.error = "none",
zero.policy = TRUE
)
summary(m_sdm_naive)
summary(m_sdm_ilr)
summary(m_sdm_proj)
impacts_splm_safe <- function(m, listw, TT, R = 300) {
if (is.null(attr(m, "have_factor_preds"))) attr(m, "have_factor_preds") <- FALSE
imp <- splm:::impacts.splm_ML(m, listw = listw, time = TT)
imp_sim <- splm:::impacts.splm_ML(m, listw = listw, time = TT, R = R)
list(point = imp, sim = summary(imp_sim))
}
TT <- length(unique(sdm_df$year))
imp_naive <- impacts_splm_safe(m_sdm_naive, lw_knn, TT)
imp_ilr   <- impacts_splm_safe(m_sdm_ilr,   lw_knn, TT)
imp_proj  <- impacts_splm_safe(m_sdm_proj,  lw_knn, TT)
imp_naive$point; imp_naive$sim
imp_ilr$point;   imp_ilr$sim
imp_proj$point;  imp_proj$sim
sdm_df$resid_sdm_ilr <- residuals(m_sdm_ilr)
moran_resid_sdm <- tibble(year = sort(unique(sdm_df$year))) %>%
mutate(I = purrr::map_dbl(year, ~{
x <- sdm_df %>% filter(year == .x) %>% arrange(itl_code)
spdep::moran.test(x$resid_sdm_ilr, lw_knn, zero.policy = TRUE)$estimate[["Moran I statistic"]]
}))
ggplot(moran_resid_sdm, aes(year, I)) + geom_line() + theme_minimal() +
labs(title="Moran’s I of SDM(ILR) residuals over time", y="Moran I", x=NULL)
print(moran_resid_sdm)
# =========================
# Rolling forecasting sanity check
# Why your previous plot was empty:
#   Two-way FE (itl_code + year) cannot predict for an unseen test year because the year fixed-effect
#   does not exist in the training sample -> predict() returns NA -> RMSE/MAE become NaN.
#
# Fix:
#   Use region FE only (itl_code) for forecasting, and add a macro control that exists in the test year
#   (national lead growth g_nat_lead). This keeps the spirit of FE while allowing OOS prediction.
# =========================
years <- sort(unique(panel_model_df$year))
min_train_years <- 10
test_years <- years[(min_train_years + 1):length(years)]
rmse <- function(a,b) sqrt(mean((a-b)^2, na.rm=TRUE))
mae  <- function(a,b) mean(abs(a-b), na.rm=TRUE)
# prediction formulas (region FE only)
f_naive_pred <- g_real_lead ~ d_js_dist + hhi + entropy + switch + g_nat_lead | itl_code
ilr_terms <- paste0("z", 1:17, collapse = " + ")
f_ilr_pred <- as.formula(paste0("g_real_lead ~ ", ilr_terms, " + switch + g_nat_lead | itl_code"))
roll_res <- purrr::map_dfr(test_years, function(y_test){
train <- panel_model_df %>%
dplyr::filter(year < y_test) %>%
tidyr::drop_na(g_real_lead, d_js_dist, hhi, entropy, switch, g_nat_lead)
test <- panel_model_df %>%
dplyr::filter(year == y_test) %>%
tidyr::drop_na(g_real_lead, d_js_dist, hhi, entropy, switch, g_nat_lead)
# if test is empty for some reason, return NA rows
if (nrow(test) == 0) {
return(tibble::tibble(year = y_test,
rmse_naive = NA_real_, mae_naive = NA_real_,
rmse_ilr = NA_real_,   mae_ilr = NA_real_))
}
# naive
m1 <- fixest::feols(f_naive_pred, data=train, vcov="cluster")
p1 <- predict(m1, newdata=test)
# ilr
train2 <- panel_model_df %>%
dplyr::filter(year < y_test) %>%
tidyr::drop_na(g_real_lead, switch, g_nat_lead, z1)
test2 <- panel_model_df %>%
dplyr::filter(year == y_test) %>%
tidyr::drop_na(g_real_lead, switch, g_nat_lead, z1)
m2 <- fixest::feols(f_ilr_pred, data=train2, vcov="cluster")
p2 <- predict(m2, newdata=test2)
tibble::tibble(
year = y_test,
rmse_naive = rmse(test$g_real_lead, p1),
mae_naive  = mae(test$g_real_lead, p1),
rmse_ilr   = rmse(test2$g_real_lead, p2),
mae_ilr    = mae(test2$g_real_lead, p2)
)
})
print(roll_res)
ggplot2::ggplot(roll_res, ggplot2::aes(year, rmse_naive)) +
ggplot2::geom_line() +
ggplot2::geom_line(ggplot2::aes(y = rmse_ilr)) +
ggplot2::theme_minimal() +
ggplot2::labs(title = "Rolling forecast RMSE: naive vs ILR (region FE + macro control)",
y = "RMSE", x = NULL)
ggplot2::ggplot(roll_res, ggplot2::aes(year, mae_naive)) +
ggplot2::geom_line() +
ggplot2::geom_line(ggplot2::aes(y = mae_ilr)) +
ggplot2::theme_minimal() +
ggplot2::labs(title = "Rolling forecast MAE: naive vs ILR (region FE + macro control)",
y = "MAE", x = NULL)
# Helper: map a detailed SIC07 code to a broad section letter (A..T, optionally U).
# The dataset sometimes uses:
# - section labels (A, B, C...) or "AB (1-9)" aggregates
# - numeric SIC codes (01, 10, 62, etc.)
#
# We map numeric 2-digit prefixes to sections using UK SIC 2007 section ranges.
sic07_to_section <- function(sector_code) {
sc <- as.character(sector_code)
sc <- stringr::str_trim(sc)
# already an aggregate like "AB (1-9)" or "C (10-33)" -> take leading letters
if (stringr::str_detect(sc, "^[A-Z]{1,2}\\s*\\(")) {
return(stringr::str_extract(sc, "^[A-Z]{1,2}"))
}
# if it begins with a letter section (rare in some sheets)
if (stringr::str_detect(sc, "^[A-Z]{1,2}$")) return(sc)
# otherwise try numeric mapping by 2-digit prefix
d2 <- suppressWarnings(as.integer(stringr::str_extract(sc, "^\\d{2}")))
if (is.na(d2)) return(NA_character_)
dplyr::case_when(
d2 %in%  1: 3 ~ "A",
d2 %in%  5: 9 ~ "B",
d2 %in% 10:33 ~ "C",
d2 == 35       ~ "D",
d2 %in% 36:39  ~ "E",
d2 %in% 41:43  ~ "F",
d2 %in% 45:47  ~ "G",
d2 %in% 49:53  ~ "H",
d2 %in% 55:56  ~ "I",
d2 %in% 58:63  ~ "J",
d2 %in% 64:66  ~ "K",
d2 == 68       ~ "L",
d2 %in% 69:75  ~ "M",
d2 %in% 77:82  ~ "N",
d2 == 84       ~ "O",
d2 == 85       ~ "P",
d2 %in% 86:88  ~ "Q",
d2 %in% 90:93  ~ "R",
d2 %in% 94:96  ~ "S",
d2 %in% 97:98  ~ "T",
d2 == 99       ~ "U",
TRUE ~ NA_character_
)
}
entropy_decompose <- function(df_long_shares, share_col = "share") {
# expects columns: itl_code, region_name, year, sector_code, share
df <- df_long_shares %>%
dplyr::mutate(
share = as.numeric(.data[[share_col]]),
share = dplyr::if_else(is.finite(share) & share > 0, share, 0),
section = vapply(sector_code, sic07_to_section, character(1))
) %>%
dplyr::filter(!is.na(section))
# group sums P_g and conditional shares p_{k|g}
out <- df %>%
dplyr::group_by(itl_code, region_name, year) %>%
dplyr::mutate(
H_total = -sum(dplyr::if_else(share > 0, share * log(share), 0), na.rm = TRUE)
) %>%
dplyr::group_by(itl_code, region_name, year, section) %>%
dplyr::summarise(
P_g = sum(share, na.rm = TRUE),
H_g = {
if (P_g[1] <= 0) 0 else {
p_cond <- share / P_g[1]
-sum(dplyr::if_else(p_cond > 0, p_cond * log(p_cond), 0), na.rm = TRUE)
}
},
.groups = "drop_last"
) %>%
dplyr::summarise(
UV = -sum(dplyr::if_else(P_g > 0, P_g * log(P_g), 0), na.rm = TRUE),
RV =  sum(P_g * H_g, na.rm = TRUE),
.groups = "drop"
) %>%
dplyr::left_join(
df %>% dplyr::distinct(itl_code, region_name, year) %>%
dplyr::left_join(
df %>%
dplyr::group_by(itl_code, region_name, year) %>%
dplyr::summarise(H_total = -sum(dplyr::if_else(share > 0, share * log(share), 0), na.rm = TRUE),
.groups="drop"),
by=c("itl_code","region_name","year")
),
by = c("itl_code","region_name","year")
) %>%
dplyr::mutate(check = H_total - (RV + UV))
out
}
# Decomposition on the current 18-sector shares
rvuv_18 <- entropy_decompose(shares_long2)
rvuv_18 %>%
dplyr::summarise(
check_abs_max = max(abs(check), na.rm=TRUE),
UV_q = paste(round(quantile(UV, c(.01,.05,.5,.95,.99), na.rm=TRUE), 4), collapse=" | "),
RV_q = paste(round(quantile(RV, c(.01,.05,.5,.95,.99), na.rm=TRUE), 4), collapse=" | ")
) %>% print()
# Visual sanity: RV + UV should replicate total entropy
ggplot2::ggplot(rvuv_18, ggplot2::aes(H_total, RV + UV)) +
ggplot2::geom_point(alpha = 0.2) +
ggplot2::theme_minimal() +
ggplot2::labs(title = "Entropy decomposition check: H_total vs RV+UV", x="Total entropy", y="RV + UV")
# Add RV/UV into your modeling dataframe
panel_model_df <- panel_model_df %>%
dplyr::left_join(rvuv_18 %>% dplyr::select(itl_code, year, RV, UV), by=c("itl_code","year"))
# FE with decomposition (baseline)
m_rvuv <- fixest::feols(
g_real_lead ~ RV + UV + switch | itl_code + year,
data = panel_model_df,
vcov = "cluster"
)
fixest::etable(m_rvuv)
# Choose baseline year per region (first observed)
t0_by_region <- shares_long2 %>%
dplyr::group_by(itl_code) %>%
dplyr::summarise(t0 = min(year, na.rm=TRUE), .groups="drop")
shares_t0 <- shares_long2 %>%
dplyr::inner_join(t0_by_region, by="itl_code") %>%
dplyr::filter(year == t0) %>%
dplyr::select(itl_code, sector_code, share0 = share)
# National sector growth g_nat(s,t) using the SAME STRUCT_MEASURE (nominal current price in your config)
nat_g <- eng_tl3_struct %>%
dplyr::filter(sector_code %in% sectors18) %>%
dplyr::group_by(year, sector_code) %>%
dplyr::summarise(nat_val = sum(value, na.rm=TRUE), .groups="drop") %>%
dplyr::arrange(sector_code, year) %>%
dplyr::group_by(sector_code) %>%
dplyr::mutate(g_nat = log(nat_val) - log(dplyr::lag(nat_val))) %>%
dplyr::ungroup() %>%
dplyr::filter(is.finite(g_nat))
bartik_exposure <- tidyr::expand_grid(
itl_code = unique(shares_t0$itl_code),
year = sort(unique(nat_g$year))
) %>%
dplyr::left_join(shares_t0, by="itl_code") %>%
dplyr::left_join(nat_g %>% dplyr::select(year, sector_code, g_nat), by=c("year","sector_code")) %>%
dplyr::mutate(g_nat = tidyr::replace_na(g_nat, 0)) %>%
dplyr::group_by(itl_code, year) %>%
dplyr::summarise(exposure = sum(share0 * g_nat, na.rm=TRUE), .groups="drop")
# Merge into model df
panel_model_df <- panel_model_df %>%
dplyr::left_join(bartik_exposure, by=c("itl_code","year"))
# National total growth sign (recession/expansion proxy)
nat_total <- eng_tl3_struct %>%
dplyr::filter(sector_code=="Total") %>%
dplyr::group_by(year) %>%
dplyr::summarise(nat_total = sum(value, na.rm=TRUE), .groups="drop") %>%
dplyr::arrange(year) %>%
dplyr::mutate(g_nat_total = log(nat_total) - log(dplyr::lag(nat_total)))
panel_model_df <- panel_model_df %>%
dplyr::left_join(nat_total %>% dplyr::select(year, g_nat_total), by="year") %>%
dplyr::mutate(nat_downturn = is.finite(g_nat_total) & g_nat_total < 0)
# (A) Exposure variance vs diversity (cross-sectional by region)
exposure_var <- bartik_exposure %>%
dplyr::group_by(itl_code) %>%
dplyr::summarise(exposure_sd = sd(exposure, na.rm=TRUE), .groups="drop") %>%
dplyr::left_join(
rvuv_18 %>% dplyr::group_by(itl_code) %>%
dplyr::summarise(RV_mean = mean(RV, na.rm=TRUE), UV_mean = mean(UV, na.rm=TRUE), .groups="drop"),
by="itl_code"
)
ggplot2::ggplot(exposure_var, ggplot2::aes(UV_mean, exposure_sd)) +
ggplot2::geom_point(alpha=0.6) +
ggplot2::theme_minimal() +
ggplot2::labs(title="Do more unrelated-diverse regions have lower exposure variance?", x="Mean UV", y="SD(Exposure)")
# (B) FE regression: does exposure predict next-year growth, and does it matter more in downturns?
m_bartik <- fixest::feols(
g_real_lead ~ exposure + exposure:nat_downturn + RV + UV | itl_code + year,
data = panel_model_df,
vcov = "cluster"
)
fixest::etable(m_bartik)
# build horizons h=0..5 using realized growth at t+h (not lead-only)
# g_real in real_total is growth at year t: log(GVA_t) - log(GVA_{t-1})
# We'll project future g_real onto current structure controls.
max_h <- 5
lp_base <- real_total %>%
dplyr::select(itl_code, region_name, year, g_real) %>%
dplyr::arrange(itl_code, year)
# merge covariates at time t
X_t <- panel_model_df %>%
dplyr::select(itl_code, year, RV, UV, exposure, d_js_dist, hhi, entropy, switch, nat_downturn)
run_lp <- function(h) {
y_h <- lp_base %>%
dplyr::group_by(itl_code) %>%
dplyr::mutate(y = dplyr::lead(g_real, h)) %>%
dplyr::ungroup() %>%
dplyr::select(itl_code, year, y)
dfh <- y_h %>%
dplyr::left_join(X_t, by=c("itl_code","year")) %>%
dplyr::filter(is.finite(y))
m <- tryCatch(
fixest::feols(
y ~ exposure + RV + UV + switch | itl_code + year,
data = dfh,
vcov = "cluster"
),
error = function(e) NULL
)
if (is.null(m)) {
return(tibble::tibble(
h = h,
b_exposure = NA_real_, se_exposure = NA_real_,
b_RV = NA_real_, se_RV = NA_real_,
b_UV = NA_real_, se_UV = NA_real_
))
}
# robust extractors: variables can be dropped (collinearity / empty within-year variation)
get_coef <- function(mod, term) {
cf <- stats::coef(mod)
if (!is.null(cf) && term %in% names(cf)) as.numeric(cf[[term]]) else NA_real_
}
get_se <- function(mod, term) {
V <- tryCatch(vcov(mod), error = function(e) NULL)
if (is.null(V) || is.null(colnames(V)) || !(term %in% colnames(V))) return(NA_real_)
as.numeric(sqrt(diag(V))[term])
}
tibble::tibble(
h = h,
b_exposure = get_coef(m, "exposure"),
se_exposure = get_se(m, "exposure"),
b_RV = get_coef(m, "RV"),
se_RV = get_se(m, "RV"),
b_UV = get_coef(m, "UV"),
se_UV = get_se(m, "UV")
)
}
lp_res <- purrr::map_dfr(0:max_h, run_lp)
lp_res %>% print(n=50)
# Plot impulse-style coefficient paths
plot_ci <- function(df, b, se, title) {
ggplot2::ggplot(df, ggplot2::aes(h, .data[[b]])) +
ggplot2::geom_line() +
ggplot2::geom_point() +
ggplot2::geom_errorbar(ggplot2::aes(ymin = .data[[b]] - 1.96*.data[[se]],
ymax = .data[[b]] + 1.96*.data[[se]]),
width = 0.2) +
ggplot2::theme_minimal() +
ggplot2::labs(title=title, x="Horizon h (years ahead)", y="Coefficient")
}
plot_ci(lp_res, "b_exposure", "se_exposure", "Local projections: exposure → future growth")
plot_ci(lp_res, "b_RV", "se_RV", "Local projections: RV → future growth")
plot_ci(lp_res, "b_UV", "se_UV", "Local projections: UV → future growth")
# Regime split: downturn vs expansion (national total growth sign)
m_regime <- fixest::feols(
g_real_lead ~ exposure * nat_downturn + RV * nat_downturn + UV * nat_downturn + switch | itl_code + year,
data = panel_model_df,
vcov = "cluster"
)
fixest::etable(m_regime)
# Outcome-bin heterogeneity (simple, defensible):
# Estimate the same FE model separately for bottom vs top growth deciles (of g_real_lead).
cut_lo <- quantile(panel_model_df$g_real_lead, 0.10, na.rm=TRUE)
cut_hi <- quantile(panel_model_df$g_real_lead, 0.90, na.rm=TRUE)
df_lo <- panel_model_df %>% dplyr::filter(g_real_lead <= cut_lo)
df_hi <- panel_model_df %>% dplyr::filter(g_real_lead >= cut_hi)
m_lo <- fixest::feols(g_real_lead ~ exposure + RV + UV + switch | itl_code + year, data=df_lo, vcov="cluster")
m_hi <- fixest::feols(g_real_lead ~ exposure + RV + UV + switch | itl_code + year, data=df_hi, vcov="cluster")
fixest::etable(m_lo, m_hi, dict=c(exposure="Bartik exposure", RV="Related variety", UV="Unrelated variety"))
if (!requireNamespace("splm", quietly = TRUE)) install.packages("splm")
library(splm)
# Build a clean spatial panel dataset (same ordering as weights)
sp_df <- panel_model_df %>%
dplyr::select(itl_code, year, g_real_lead, exposure, RV, UV, switch) %>%
tidyr::drop_na() %>%
dplyr::arrange(itl_code, year)
ord <- itl3_eng$itl_code
sp_df <- sp_df %>% dplyr::filter(itl_code %in% ord) %>%
dplyr::mutate(itl_code = factor(itl_code, levels = ord)) %>%
dplyr::arrange(itl_code, year)
# Alias (some earlier notes used this name)
sdm_short_df <- sp_df
TT_sp <- length(unique(sdm_short_df$year))
# -----------------------------
# Robust TWFE handling:
# splm::spml(model="within", effect="twoways") cannot identify
# time-only or unit-only regressors. Drop them automatically.
# -----------------------------
drop_unidentified_twfe <- function(df, id="itl_code", tt="year", vars) {
vars <- intersect(vars, names(df))
if (length(vars) == 0) return(character(0))
time_only <- vars[sapply(vars, function(v) {
sd_by_t <- df %>%
dplyr::group_by(.data[[tt]]) %>%
dplyr::summarise(sd = sd(.data[[v]], na.rm=TRUE), .groups="drop") %>%
dplyr::pull(sd)
all(is.na(sd_by_t) | sd_by_t < 1e-12)
})]
unit_only <- vars[sapply(vars, function(v) {
sd_by_i <- df %>%
dplyr::group_by(.data[[id]]) %>%
dplyr::summarise(sd = sd(.data[[v]], na.rm=TRUE), .groups="drop") %>%
dplyr::pull(sd)
all(is.na(sd_by_i) | sd_by_i < 1e-12)
})]
unique(c(time_only, unit_only))
}
safe_spml <- function(form, data, listw,
effect = "twoways",
Durbin = FALSE,
lag = FALSE,
spatial.error = "none") {
# Ensure deps
if (!requireNamespace("plm", quietly = TRUE)) install.packages("plm")
if (!requireNamespace("splm", quietly = TRUE)) install.packages("splm")
# Identify RHS vars present in data
yvar <- all.vars(form)[1]
rhs_vars <- setdiff(all.vars(form), yvar)
rhs_vars <- rhs_vars[rhs_vars %in% names(data)]
# Drop regressors not identified under TWFE (time-only or unit-only)
if (effect == "twoways") {
drop_vars <- drop_unidentified_twfe(data, vars = rhs_vars)
if (length(drop_vars) > 0) {
message("Dropping unidentified TWFE regressors: ", paste(drop_vars, collapse = ", "))
for (v in drop_vars) form <- update(form, paste0(". ~ . - ", v))
}
}
# --- Route non-spatial model to plm (splm refuses) ---
no_spatial_component <- (!isTRUE(lag)) && (!isTRUE(Durbin)) && identical(spatial.error, "none")
if (no_spatial_component) {
# Must be ordered and indexed
df_plm <- data %>%
dplyr::arrange(itl_code, year)
m_plm <- plm::plm(
form,
data  = df_plm,
index = c("itl_code", "year"),
model = "within",
effect = effect
)
attr(m_plm, "model_class") <- "plm_within"  # tiny tag for downstream if you want
return(m_plm)
}
# --- Otherwise: spatial model via splm::spml ---
try_fit_spml <- function(f) {
splm::spml(
f,
data = data,
index = c("itl_code","year"),
listw = listw,
model = "within",
effect = effect,
lag = lag,
Durbin = Durbin,
spatial.error = spatial.error,
zero.policy = TRUE
)
}
out <- tryCatch(try_fit_spml(form), error = function(e) e)
if (!inherits(out, "error")) return(out)
# If still singular, try greedy drop
message("spml failed (likely singular X'X). Attempting greedy drop…")
terms_rhs <- attr(terms(form), "term.labels")
# (Optional) avoid dropping key spatial structure first if you have preferences.
# We'll just try in reverse order:
for (v in rev(terms_rhs)) {
f2 <- update(form, paste0(". ~ . - ", v))
out2 <- tryCatch(try_fit_spml(f2), error = function(e) e)
if (!inherits(out2, "error")) {
message("Recovered by dropping: ", v)
return(out2)
}
}
stop(out$message)
}
# Model formula (keep identified, avoid redundant entropy alongside RV+UV)
f_sp <- g_real_lead ~ exposure + RV + UV + switch
m_SDM <- safe_spml(f_sp, data=sdm_short_df, listw=lw_knn, effect="twoways",
lag=TRUE, Durbin=TRUE, spatial.error="none")
m_SAR <- safe_spml(f_sp, data=sdm_short_df, listw=lw_knn, effect="twoways",
lag=TRUE, Durbin=FALSE, spatial.error="none")
